# ===========================================================================
# BrainTwinX — Example environment configuration
# ===========================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored.
#
#   cp .env.example .env
#
# PLACEHOLDERS ONLY. Never commit real secrets, keys, or passwords.
# Every value below is a non-functional placeholder.
# ===========================================================================


# ---------------------------------------------------------------------------
# Runtime profile
# ---------------------------------------------------------------------------
# One of: dev | prod
# `prod` disables all development-only behaviour, including stub inference.
SPRING_PROFILES_ACTIVE=dev


# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=braintwinx
MYSQL_USERNAME=braintwinx_app
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Root password is used only by the local MySQL container for initialisation.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD


# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Must be a high-entropy secret of at least 256 bits for HS256.
# Generate one with:  openssl rand -base64 48
# The application refuses to start with a weak or placeholder value.
JWT_SECRET=CHANGE_ME_GENERATE_A_256_BIT_RANDOM_SECRET

# Token lifetimes, in seconds.
JWT_ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
JWT_REFRESH_TOKEN_TTL_SECONDS=604800    # 7 days
JWT_ISSUER=braintwinx


# ---------------------------------------------------------------------------
# Backend service
# ---------------------------------------------------------------------------
BACKEND_PORT=8080

# Comma-separated allow-list of browser origins. Never use `*` with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------
# Internal address. This service must NOT be exposed publicly — its
# /internal/ai/** routes assume a trusted network boundary.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_PORT=8001
AI_SERVICE_TIMEOUT_MS=30000

# Shared secret for backend -> AI service authentication.
AI_SERVICE_API_KEY=CHANGE_ME_INTERNAL_SHARED_SECRET


# ---------------------------------------------------------------------------
# Model weights
# ---------------------------------------------------------------------------
# Weights are NOT in version control and are NOT currently available.
# See docs/DATASET_SETUP.md. While these paths are unpopulated the AI service
# reports NOT READY and analysis endpoints return a typed error rather than
# any prediction.
MODEL_WEIGHTS_DIR=./ai-service/models/weights
CLASSIFIER_WEIGHTS_PATH=${MODEL_WEIGHTS_DIR}/brain_tumor_classifier_v1.0.0.pt
SEGMENTER_WEIGHTS_PATH=${MODEL_WEIGHTS_DIR}/brain_tumor_unet_v1.0.0.pt
FORECASTER_WEIGHTS_PATH=${MODEL_WEIGHTS_DIR}/tumor_trend_lstm_v0.9.0.pt

# Optional SHA-256 checksums. When set, a weights file whose digest does not
# match is refused rather than loaded.
CLASSIFIER_WEIGHTS_SHA256=
SEGMENTER_WEIGHTS_SHA256=
FORECASTER_WEIGHTS_SHA256=


# ---------------------------------------------------------------------------
# Development stub inference  —  SAFETY CRITICAL
# ---------------------------------------------------------------------------
# When true, the AI service returns SYNTHETIC, NON-CLINICAL output so that
# service wiring can be exercised without trained weights.
#
# This MUST remain false outside local development. Synthetic output is
# always tagged as non-clinical in the response payload, and the production
# profile refuses to start if this is enabled.
AI_ALLOW_STUB_INFERENCE=false


# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=52428800          # 50 MiB
MAX_IMAGE_PIXELS=40000000               # decompression-bomb guard


# ---------------------------------------------------------------------------
# Longitudinal analysis policy
# ---------------------------------------------------------------------------
# Below either threshold the system returns INSUFFICIENT_HISTORY and does not
# produce a trend estimate. See docs/ASSUMPTIONS.md A-5 — these are domain
# settings and should be reviewed by a qualified professional.
LONGITUDINAL_MIN_OBSERVATIONS=3
LONGITUDINAL_MIN_SPAN_DAYS=30


# ---------------------------------------------------------------------------
# Explanation layer (LLM)
# ---------------------------------------------------------------------------
# Provider-agnostic. When unset, the explanation step fails closed: it returns
# a typed error, and analysis plus reporting still complete with the
# explanation section marked "Not available".
#
# The provider receives ONLY structured, allow-listed model output. It never
# receives the MRI image, file paths, or free-text patient data.
EXPLANATION_ENABLED=false
EXPLANATION_PROVIDER=                   # e.g. anthropic
EXPLANATION_MODEL=                      # e.g. claude-sonnet-5
EXPLANATION_API_KEY=CHANGE_ME_OR_LEAVE_EMPTY_TO_DISABLE
EXPLANATION_TIMEOUT_MS=20000


# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# Never enable in production: raises SQL and framework logging verbosity and
# risks sensitive values reaching logs.
LOG_SQL=false
